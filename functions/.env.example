# Deploy-time values for functions/project.yml — copy to functions/.env
# and fill in. NEVER commit the real .env.

# From the GitHub OAuth App (Settings → Developer settings → OAuth Apps):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated hosts allowed to receive tokens from this proxy.
# Wildcards allowed for subdomains. Keep localhost for local CMS testing.
ALLOWED_DOMAINS=resultsmatrix.com,www.resultsmatrix.com,*.ondigitalocean.app,localhost:4321
