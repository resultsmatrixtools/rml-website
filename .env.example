# ------------------------------------------------------------------
# Build-time environment variables (see BRIEF.md §8).
# On DigitalOcean App Platform these are injected at build time via the
# app spec (.do/app.yaml) — set the real values in the DO dashboard or
# spec, never in a committed file. For local development, copy this file
# to .env and fill in values (.env is gitignored).
#
# All variables use Astro's PUBLIC_ prefix because they are read in
# client-visible code via import.meta.env.
# ------------------------------------------------------------------

# HubSpot portal (account) ID — used by the tracking script and Forms API.
PUBLIC_HUBSPOT_PORTAL_ID=

# HubSpot form GUIDs (Forms Submission API v3), one per form. A form whose
# portal ID or GUID is missing at build time cannot submit: the request code
# is stripped as dead code and the form shows its error state (with the email
# fallback) on every attempt. See the README runbook for form setup.
PUBLIC_HUBSPOT_FORM_GUID_CONTACT=
PUBLIC_HUBSPOT_FORM_GUID_RESOURCE=
PUBLIC_HUBSPOT_FORM_GUID_CONSULT=

# External payment link for paid consultations (eZeePayments or WiPay —
# provider TBD). Leave unset or "#" to render "Online payment coming soon".
PUBLIC_CONSULTATION_PAYMENT_URL=

# Canonical site URL — differs between production and staging.
# Production: https://resultsmatrix.com
# Staging:    the staging app's ondigitalocean.app URL
# NOTE: this also gates blog drafts — exactly "https://resultsmatrix.com"
# hides draft posts (production); any other value (or unset) shows them.
# Leave it unset locally if you want to preview drafts.
PUBLIC_SITE_URL=https://resultsmatrix.com
