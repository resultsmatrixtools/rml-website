---
// Cookie-consent banner (BRIEF.md §5). The HubSpot tracking script loads
// only after the visitor accepts; the choice persists in localStorage
// (the one legitimate localStorage use on this static site). Declining
// keeps the site fully functional with no tracking.
---

<div
  id="consent-banner"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-slate-200 bg-white p-4 shadow-[0_-4px_16px_rgba(13,27,43,0.08)]"
  role="region"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed text-slate-700">
      We use a single analytics cookie (HubSpot) to understand how this site is
      used. It runs only if you accept. See our <a href="/privacy" class="font-medium text-accent-700 underline hover:text-accent-800">privacy &amp; cookie policy</a>.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        id="consent-decline"
        class="press rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
      >
        Decline
      </button>
      <button
        type="button"
        id="consent-accept"
        class="press rounded bg-brand-800 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<style>
  /* Overlay arrival (The Entrance-Only Rule): the banner rises from the
     edge it lives on. @starting-style + allow-discrete animate the
     display:none → visible flip; older browsers just show it instantly. */
  #consent-banner {
    transition:
      transform 300ms var(--ease-out-strong),
      opacity 300ms var(--ease-out-strong),
      display 300ms allow-discrete;
  }

  @starting-style {
    #consent-banner:not(.hidden) {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #consent-banner {
      transition:
        opacity 200ms ease,
        display 200ms allow-discrete;
    }

    @starting-style {
      #consent-banner:not(.hidden) {
        transform: none;
        opacity: 0;
      }
    }
  }
</style>

<script>
  const CONSENT_KEY = 'rml-cookie-consent'; // 'accepted' | 'declined'
  const portalId = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID;

  const banner = document.getElementById('consent-banner')!;

  function loadHubSpot() {
    if (!portalId || document.getElementById('hs-script-loader')) return;
    const script = document.createElement('script');
    script.id = 'hs-script-loader';
    script.src = `https://js.hs-scripts.com/${portalId}.js`;
    script.async = true;
    script.defer = true;
    document.body.appendChild(script);
  }

  function choose(value: 'accepted' | 'declined') {
    try {
      localStorage.setItem(CONSENT_KEY, value);
    } catch {
      /* storage unavailable (private mode) — treat as session-only choice */
    }
    banner.classList.add('hidden');
    if (value === 'accepted') loadHubSpot();
  }

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(CONSENT_KEY);
  } catch {
    /* ignore */
  }

  if (stored === 'accepted') {
    loadHubSpot();
  } else if (stored !== 'declined') {
    banner.classList.remove('hidden');
  }

  document.getElementById('consent-accept')!.addEventListener('click', () => choose('accepted'));
  document.getElementById('consent-decline')!.addEventListener('click', () => choose('declined'));

  // Lets the privacy page (or console) re-open the choice:
  // window.rmlResetConsent() clears the stored value and shows the banner.
  (window as any).rmlResetConsent = () => {
    try {
      localStorage.removeItem(CONSENT_KEY);
    } catch {
      /* ignore */
    }
    banner.classList.remove('hidden');
  };
</script>
