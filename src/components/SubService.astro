---
// Sub-service block for service pages (BRIEF.md §2): the intro paragraph
// and Value Proposition stay always visible; the detailed service lists
// collapse behind native <details> (no JS, keyboard-accessible).

interface Group {
  label: string;
  items: string[];
}

interface Props {
  title: string;
  intro?: string;
  valueProp: string;
  groups: Group[];
}

const { title, intro, valueProp, groups } = Astro.props;
---

<article class="rounded border border-slate-200 bg-white p-6 sm:p-8">
  <h3 class="text-xl font-bold text-brand-900">{title}</h3>

  {intro && <p class="mt-3 max-w-prose font-serif text-lg leading-[1.7] text-slate-700">{intro}</p>}

  <p class="mt-4 max-w-prose font-serif text-lg italic leading-[1.7] text-accent-800">
    <span class="font-sans text-sm font-semibold not-italic text-accent-700">Value proposition&nbsp;·&nbsp;</span>{valueProp}
  </p>

  <div class="mt-5 space-y-2">
    {
      groups.map((group) => (
        <details class="group rounded border border-slate-200">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50 [&::-webkit-details-marker]:hidden">
            {group.label}
            <svg
              class="h-4 w-4 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <ul class="space-y-2.5 border-t border-slate-200 px-4 py-4 pl-9">
            {group.items.map((item) => {
              const [lead, ...rest] = item.split(': ');
              return rest.length > 0 ? (
                <li class="list-disc text-base leading-relaxed text-slate-700">
                  <strong class="font-semibold text-slate-900">{lead}:</strong> {rest.join(': ')}
                </li>
              ) : (
                <li class="list-disc text-base leading-relaxed text-slate-700">{item}</li>
              );
            })}
          </ul>
        </details>
      ))
    }
  </div>
</article>
