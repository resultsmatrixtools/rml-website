---
// Sub-service block for service pages (BRIEF.md §2): the intro paragraph
// and Value Proposition stay always visible; the detailed service lists
// collapse behind native <details> (no JS, keyboard-accessible).

interface Group {
  label: string;
  items: string[];
}

interface Props {
  title: string;
  intro?: string;
  valueProp: string;
  groups?: Group[];
}

const { title, intro, valueProp, groups = [] } = Astro.props;
---

<article class="rounded-xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
  <h2 class="text-xl font-bold tracking-tight text-brand-950 sm:text-2xl">{title}</h2>

  {intro && <p class="mt-3 max-w-prose font-serif text-lg leading-[1.7] text-slate-700">{intro}</p>}

  <div class="mt-5 rounded-lg border-l-4 border-accent-600 bg-accent-50/60 p-4 sm:p-5">
    <p class="max-w-prose font-serif text-lg italic leading-[1.7] text-accent-950">
      <span class="font-sans text-xs font-bold uppercase tracking-wider not-italic text-accent-700 block mb-1">Value Proposition</span>{valueProp}
    </p>
  </div>

  <div class:list={['space-y-3', groups.length > 0 && 'mt-6']}>
    {
      groups.map((group) => (
        <details class="group/det rounded-lg border border-slate-200/90 transition-all duration-150 group-open/det:border-slate-300 group-open/det:bg-slate-50/50">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 text-sm font-semibold text-brand-900 transition-colors hover:bg-brand-50/50 [&::-webkit-details-marker]:hidden">
            <span>{group.label}</span>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-transform duration-200 group-open/det:rotate-180 group-open/det:bg-brand-100 group-open/det:text-brand-800">
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <div class="border-t border-slate-200/80 bg-white px-5 py-4 pl-9">
            <ul class="space-y-3">
              {group.items.map((item) => {
                const [lead, ...rest] = item.split(': ');
                return rest.length > 0 ? (
                  <li class="list-disc text-base leading-relaxed text-slate-700">
                    <strong class="font-semibold text-slate-900">{lead}:</strong> {rest.join(': ')}
                  </li>
                ) : (
                  <li class="list-disc text-base leading-relaxed text-slate-700">{item}</li>
                );
              })}
            </ul>
            <div class="mt-6 border-t border-slate-100 pt-4">
              <a
                href="/contact/"
                class="press inline-flex items-center gap-2 rounded bg-brand-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-900"
              >
                <span>Get in touch</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</article>
