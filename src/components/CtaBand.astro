---
// Full-width call-to-action band. Every page resolves toward a low-risk
// action (PRODUCT.md principle 4); this is the standard closing move.

interface Props {
  heading: string;
  text?: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { heading, text, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="bg-brand-900 text-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 class="text-2xl font-bold sm:text-3xl">{heading}</h2>
        {text && <p class="mt-3 max-w-xl text-brand-200">{text}</p>}
      </div>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <a
          href={primaryHref}
          class="rounded bg-white px-6 py-3 text-center text-sm font-semibold text-brand-900 transition-colors hover:bg-brand-100"
        >
          {primaryLabel}
        </a>
        {
          secondaryHref && secondaryLabel && (
            <a
              href={secondaryHref}
              class="rounded border border-brand-400 px-6 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-brand-800"
            >
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
