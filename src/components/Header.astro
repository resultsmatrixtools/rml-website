---
// Site header + navigation (desktop and mobile). Acceptance-critical:
// renders on every page via BaseLayout (BRIEF.md §8).
import logoMark from '../assets/logo/rml-mark.svg';

const navItems = [
  { href: '/services/', label: 'Services' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/resources/', label: 'Resources' },
  { href: '/consultations/', label: 'Consultations' },
];

const serviceItems = [
  { href: '/services/strategy-advisory/', label: 'Strategy & Advisory' },
  { href: '/services/research-analytics/', label: 'Research & Data Analytics' },
  { href: '/services/mel/', label: 'Monitoring, Evaluation & Learning' },
  { href: '/services/ict-systems/', label: 'ICT & Systems Development' },
];

// Compare on slash-less paths so the canonical trailing-slash hrefs still
// match a pathname however the request arrived.
const trimPath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = trimPath(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(trimPath(href));
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- The wordmark is the link's accessible name, so the two words must be
         separated by a real space rather than a flex gap: a gap leaves the
         text content reading "Results MatrixLimited" to assistive tech, copy,
         and WCAG 2.5.3. Inline spans align on the baseline on their own. -->
    <a href="/" class="flex items-center gap-2.5 text-brand-900 group">
      <img src={logoMark.src} alt="" width="38" height="36" class="h-9 w-auto transition-transform duration-200 group-hover:scale-105" />
      <span class="text-lg font-bold tracking-tight text-brand-950">Results Matrix</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        navItems.map((item) => {
          if (item.href === '/services') {
            return (
              <div class="relative group/dropdown">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded px-3 py-2 text-sm font-medium transition-all duration-150',
                    isActive(item.href)
                      ? 'bg-accent-50 text-accent-700 font-semibold'
                      : 'text-slate-600 hover:bg-slate-100/70 hover:text-brand-900',
                  ]}
                >
                  {item.label}
                  <svg class="h-3.5 w-3.5 opacity-60 transition-transform group-hover/dropdown:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full hidden w-72 pt-1 group-hover/dropdown:block group-focus-within/dropdown:block">
                  <div class="rounded-lg border border-slate-200 bg-white p-2 shadow-lg ring-1 ring-slate-900/5">
                    <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-slate-400">Practice Areas</div>
                    {serviceItems.map((sub) => (
                      <a
                        href={sub.href}
                        class:list={[
                          'block rounded-md px-3 py-2 text-xs font-semibold transition-colors',
                          isActive(sub.href)
                            ? 'bg-accent-50 text-accent-700'
                            : 'text-slate-700 hover:bg-slate-50 hover:text-brand-800',
                        ]}
                      >
                        {sub.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }
          return (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded px-3 py-2 text-sm font-medium transition-all duration-150',
                isActive(item.href)
                  ? 'bg-accent-50 text-accent-700 font-semibold'
                  : 'text-slate-600 hover:bg-slate-100/70 hover:text-brand-900',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href="/contact/"
        class="press ml-3 rounded bg-brand-800 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 hover:shadow"
      >
        Contact us
      </a>
    </nav>

    <!-- Mobile nav toggle -->
    <button
      type="button"
      id="nav-toggle"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded text-brand-900 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Open main menu</span>
      <svg id="nav-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="nav-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <nav id="mobile-nav" class="hidden border-t border-slate-200 bg-white lg:hidden" aria-label="Main menu">
    <div class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
      {
        navItems.map((item) => (
          <>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded px-3 py-2.5 text-base font-medium',
                isActive(item.href)
                  ? 'bg-accent-50 text-accent-700'
                  : 'text-slate-700 hover:bg-slate-50',
              ]}
            >
              {item.label}
            </a>
            {item.href === '/services' &&
              serviceItems.map((sub) => (
                <a
                  href={sub.href}
                  aria-current={isActive(sub.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded py-2 pl-8 pr-3 text-sm',
                    isActive(sub.href)
                      ? 'bg-accent-50 text-accent-700'
                      : 'text-slate-600 hover:bg-slate-50',
                  ]}
                >
                  {sub.label}
                </a>
              ))}
          </>
        ))
      }
      <a href="/contact/" class="press mt-2 block rounded bg-brand-800 px-4 py-2.5 text-center text-base font-semibold text-white hover:bg-brand-700">
        Contact us
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('mobile-nav')!;
  const iconOpen = document.getElementById('nav-icon-open')!;
  const iconClose = document.getElementById('nav-icon-close')!;

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
  }

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Reset the panel if the viewport grows past the lg breakpoint.
  matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
