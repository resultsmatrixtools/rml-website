---
// "The Results Matrix" — the site's signature graphic (DESIGN.md §5).
// An abstract measurement field derived from the brand logo: a 6×6 grid of
// flat cells stepping through the logo's own ramp (deep boardroom → cobalt →
// teal → lime at the upper-right corner), with the logo's white swoosh
// abstracted into a rising trendline over measured points.
//
// Growth Green appears here under the Growth Restriction Rule's data-context
// exemption: this is a diagram, not UI chrome. The graphic is deliberately
// unlabeled — no axes, no numbers — so it reads as a motif and can never be
// mistaken for a real (invented) chart.

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Logo-ramp palette, dark → lime. Indices are intensity steps.
const RAMP = [
  '#063a71', // brand-800
  '#0b4180', // brand-800/700 midpoint
  '#02458c', // brand-700
  '#0057a8', // brand-600 — Boardroom Blue
  '#1e6ba6', // logo gradient mid-blue
  '#1d7a75', // accent-600 — Caribbean Teal
  '#2b968f', // accent-500 — logo mid-band
  '#43b2a8', // accent-400
  '#78c275', // growth-500
  '#a4d56a', // growth-400 — logo lime corner
];

// Intensity per cell (row-major, top row first): a diagonal rise toward the
// upper-right with hand-placed jitter so it reads as observed measurement,
// not a smooth gradient.
const CELLS = [
  [5, 5, 7, 7, 8, 9],
  [4, 5, 5, 6, 7, 7],
  [3, 4, 4, 5, 6, 7],
  [2, 3, 4, 5, 6, 6],
  [1, 2, 3, 3, 5, 5],
  [0, 1, 1, 3, 4, 5],
];

// Cell geometry: 64px cells on a 74px pitch (10px gutters), rx proportional
// to the logo grid's 14/96.
const SIZE = 64;
const PITCH = 74;

// Trendline vertices at column centers — rise, a measured dip, strong rise.
const POINTS = [
  [32, 366],
  [106, 328],
  [180, 262],
  [254, 286],
  [328, 178],
  [402, 92],
];
const polyline = POINTS.map(([x, y]) => `${x},${y}`).join(' ');

// Load sequence timing (The Entrance-Only Rule): dots land as the 800ms
// linear draw passes their share of the path length (measured fractions of
// the ~504-unit polyline), after the DRAW_DELAY.
const DRAW_DELAY = 600;
const DOT_DELAYS = [600, 730, 890, 1010, 1220];
---

<div class:list={['relative', className]}>
  <div class="absolute -inset-6 rounded-full bg-radial from-accent-500/20 via-brand-500/10 to-transparent opacity-70 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <svg
    viewBox="0 0 434 434"
    class="relative z-10 w-full"
    aria-hidden="true"
    focusable="false"
  >
    {
      CELLS.map((row, r) =>
        row.map((step, c) => (
          <rect
            x={c * PITCH}
            y={r * PITCH}
            width={SIZE}
            height={SIZE}
            rx="9"
            fill={RAMP[step]}
            class="cell"
            style={`--s: ${c + (5 - r)}`}
          />
        ))
      )
    }
    <polyline
      class="trend"
      points={polyline}
      pathLength="1"
      fill="none"
      stroke="#ffffff"
      stroke-width="7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      class="arrow"
      d="M 397.3 114.3 L 402 92 L 380.6 100"
      fill="none"
      stroke="#ffffff"
      stroke-width="7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <g fill="#ffffff">
      {
        POINTS.slice(0, -1).map(([x, y], i) => (
          <circle class="dot" cx={x} cy={y} r="6" style={`--d: ${DOT_DELAYS[i]}ms`} />
        ))
      }
    </g>
  </svg>
</div>

<style define:vars={{ drawDelay: `${DRAW_DELAY}ms` }}>
  /* The matrix plots itself once, on load: cells cascade up the diagonal
     (35ms per step), the trendline draws linearly (constant motion = pen),
     dots land as the line passes, the arrowhead confirms last. */
  .cell {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    transform: scale(0.85);
    animation: cell-in 400ms var(--ease-out-strong) forwards;
    animation-delay: calc(var(--s) * 35ms + 120ms);
  }

  .trend {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: trend-draw 800ms linear forwards;
    animation-delay: var(--drawDelay);
  }

  .dot {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    transform: scale(0.5);
    animation: dot-in 250ms var(--ease-out-strong) forwards;
    animation-delay: var(--d);
  }

  .arrow {
    opacity: 0;
    animation: arrow-in 200ms var(--ease-out-strong) forwards;
    animation-delay: 1330ms;
  }

  @keyframes cell-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes trend-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dot-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes arrow-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell,
    .trend,
    .dot,
    .arrow {
      animation: none;
      opacity: 1;
      transform: none;
      stroke-dashoffset: 0;
    }
  }
</style>
