---
// Home — reworked per BRIEF.md §2: hero + subhead kept, three practice-area
// teasers kept, positioning paragraphs kept. The "Your Business is Our
// Business" heading, broken "0 %" counter, and orphaned widget fragments
// from the old Elementor build are dropped deliberately. CTA band links to
// /consultations and /resources.
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import MatrixMotif from '../components/MatrixMotif.astro';
import FactsStrip from '../components/FactsStrip.astro';

// How we work — a true sequence, so the numbered/glyph treatment is earned.
// The mini-matrix glyph fills one cell per step along the logo's own ramp;
// the final cell is Growth Green because completion is where growth shows.
const steps = [
  {
    title: 'Discover',
    body: 'Every engagement starts with a conversation — a free discovery session to understand your objectives, context, and constraints before any proposal is written.',
  },
  {
    title: 'Design',
    body: 'We shape the methodology, frameworks, and workplan around the decision you need to make — methodological rigor balanced with practical feasibility.',
  },
  {
    title: 'Deliver',
    body: 'Senior consultants lead every engagement — the people you meet in the proposal are the people who do the work, supported by modern tooling.',
  },
  {
    title: 'Learn',
    body: 'Deliverables arrive decision-ready, and the monitoring and learning systems behind them keep generating evidence after handover.',
  },
];

// Glyph geometry: 2×2 mini-matrix, filled bottom-left → bottom-right →
// top-left → top-right (the logo's lime corner lands last).
const glyphCells = [
  { x: 3, y: 21, fill: '#063a71' },
  { x: 21, y: 21, fill: '#0057a8' },
  { x: 3, y: 3, fill: '#1d7a75' },
  { x: 21, y: 3, fill: '#78c275' },
];

const audiences = [
  'Governments & ministries',
  'Regional organizations',
  'International development organizations',
  'NGOs & foundations',
  'Social enterprises',
];

const areas = [
  {
    href: '/services/strategy-advisory',
    title: 'Strategy & Advisory',
    body: 'We help organizations chart their course and build the systems needed to achieve lasting impact. Our strategic planning services combine rigorous analysis with participatory approaches to create actionable roadmaps aligned with national, regional, and international development frameworks.',
  },
  {
    href: '/services/research-analytics',
    title: 'Research and Data Analytics',
    body: 'We conduct rigorous research that generates actionable insights for development decision-making. Our research designs balance methodological rigor with practical feasibility, ensuring findings are both credible and useful.',
  },
  {
    href: '/services/mel',
    title: 'Monitoring, Evaluation, and Learning (MEL)',
    body: 'Strong M&E starts with solid frameworks. We design comprehensive monitoring and evaluation systems that link strategic objectives to measurable indicators, ensuring you can track progress and demonstrate results.',
  },
  {
    href: '/services/ict-systems',
    title: 'ICT Consulting, Project Management & Systems Development',
    body: 'RML designs, builds, and manages information systems for organizations that cannot afford downtime, data loss, or a system nobody ends up using. The systems we build generate the data our M&E and research practices analyze.',
  },
];
---

<BaseLayout
  title="Results Matrix Limited — Caribbean Development Solutions"
  description="Strategy & Advisory, Research & Data Analytics, and Monitoring, Evaluation & Learning services for governments and development organizations across the Caribbean."
>
  <!-- Hero — asymmetric: headline and CTAs left, the Results Matrix motif
       right (desktop only). Primary CTA is the free discovery session, the
       brief's stated conversion goal; services exploration is secondary. -->
  <section class="bg-brand-900 text-white">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
      <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,25rem)] lg:gap-20">
        <div>
          <h1 class="hero-item max-w-3xl text-display">Our Expertise, Your Insights for Action</h1>
          <p
            class="hero-item mt-6 max-w-2xl font-serif text-lg leading-[1.7] text-brand-100"
            style="--hero-delay: 90ms"
          >
            We help public and private sectors identify and deliver evidence-based results for
            decision-making and strategic objectives.
          </p>
          <div class="hero-item mt-9 flex flex-col gap-3 sm:flex-row" style="--hero-delay: 180ms">
            <a
              href="/contact"
              class="press rounded bg-white px-6 py-3 text-center text-sm font-semibold text-brand-900 hover:bg-brand-100"
            >
              Book a free discovery session
            </a>
            <a
              href="/services"
              class="press rounded border border-brand-400 px-6 py-3 text-center text-sm font-semibold text-white hover:bg-brand-800"
            >
              Explore our services
            </a>
          </div>
        </div>
        <MatrixMotif class="hidden w-full lg:block" />
      </div>
    </div>
  </section>

  <!-- Facts strip — client-cleared figures only -->
  <section aria-label="Experience at a glance" class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 lg:pt-14">
    <FactsStrip />
  </section>

  <!-- Practice areas -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20" aria-labelledby="practice-areas">
    <h2 id="practice-areas" class="text-2xl font-bold text-brand-900 sm:text-3xl" data-reveal>
      Four practice areas, one connected capability
    </h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded border border-slate-200 bg-slate-200 sm:grid-cols-2 xl:grid-cols-4">
      {
        areas.map((area, i) => (
          <article
            class="flex flex-col bg-white p-6 sm:p-8"
            data-reveal="fade"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <h3 class="text-lg font-bold text-brand-900">
              <a href={area.href} class="transition-colors hover:text-brand-700">
                {area.title}
              </a>
            </h3>
            <p class="mt-3 flex-1 text-base text-slate-700">{area.body}</p>
            <a href={area.href} class="mt-5 text-sm font-semibold text-accent-700 transition-colors hover:text-accent-800">
              Learn more <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Positioning -->
  <section class="bg-brand-50" aria-labelledby="positioning">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <h2 id="positioning" class="text-2xl font-bold text-brand-900 sm:text-3xl">
        Built for Small Island Developing States
      </h2>
      <div class="prose-serif mt-6">
        <p>
          At Results Matrix Limited, we deliver comprehensive consulting solutions that bridge the
          gap between strategic vision and measurable results. Our services span four
          interconnected practice areas: Strategy &amp; Advisory, Research and Data Analytics,
          Monitoring, Evaluation, and Learning (MEL), and ICT Consulting, Project Management &amp;
          Systems Development. Each service is designed to meet the unique challenges of Small
          Island Developing States (SIDS) especially in the Caribbean while maintaining
          international best practice standards.
        </p>
      </div>
    </div>
  </section>

  <!-- How we work — a real four-step sequence (ol), hairline-ruled -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20" aria-labelledby="how-we-work">
    <h2 id="how-we-work" class="text-2xl font-bold text-brand-900 sm:text-3xl" data-reveal>
      How we work
    </h2>
    <ol class="mt-10 grid gap-px overflow-hidden rounded border border-slate-200 bg-slate-200 sm:grid-cols-2 xl:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="bg-white p-6 sm:p-8" data-reveal="fade" style={`--reveal-delay: ${i * 60}ms`}>
            <svg viewBox="0 0 40 40" class="h-9 w-9" aria-hidden="true" focusable="false">
              {glyphCells.map((cell, c) => (
                <rect
                  x={cell.x}
                  y={cell.y}
                  width="16"
                  height="16"
                  rx="3"
                  fill={c <= i ? cell.fill : '#eff6fc'}
                />
              ))}
            </svg>
            <h3 class="mt-4 text-lg font-bold text-brand-900">
              <span class="sr-only">Step {i + 1}: </span>
              {step.title}
            </h3>
            <p class="mt-3 text-base text-slate-700">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Who we work with — kept positioning copy as the lede; partner names
       below are the wording already cleared for About. -->
  <section class="bg-brand-50" aria-labelledby="who-we-work-with">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-20">
      <h2 id="who-we-work-with" class="text-2xl font-bold text-brand-900 sm:text-3xl">
        Who we work with
      </h2>
      <div class="prose-serif mt-6">
        <p>
          We work alongside governments, regional organizations, International Development
          Organizations, NGOs, and social enterprises to strengthen systems, build capacity, and
          drive evidence-based decision-making across the Caribbean and beyond.
        </p>
      </div>
      <ul class="mt-8 flex flex-wrap gap-2">
        {
          audiences.map((audience) => (
            <li class="rounded border border-slate-300 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-700">
              {audience}
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-prose text-base text-slate-600">
        Our consultants have delivered engagements for and alongside partners including UNFPA,
        UNDP, Eve for Life, and RESEMBID.
      </p>
      <!-- PROOF SLOT: testimonials / engagement summaries / partner logos —
           add only with written client clearance (BRIEF hard rule). -->
    </div>
  </section>

  <CtaBand
    heading="Ready to put evidence to work?"
    text="Start with a free discovery session, or book a paid advisory session for focused M&E help."
    primaryHref="/contact"
    primaryLabel="Book a discovery session"
    secondaryHref="/consultations"
    secondaryLabel="Advisory sessions"
  />
</BaseLayout>

<style>
  /* Hero load sequence (The Entrance-Only Rule): headline, lede, CTAs rise
     in a 90ms stagger. Pure CSS — no JS gate, so content always appears. */
  .hero-item {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-in 500ms var(--ease-out-strong) forwards;
    animation-delay: var(--hero-delay, 0ms);
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-item {
      transform: none;
      animation-duration: 200ms;
      animation-timing-function: ease;
    }
  }
</style>
