---
// Practice-areas overview. Teaser copy is the source site's card copy
// (BRIEF.md §2); each area links through to its full page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';

const areas = [
  {
    href: '/services/strategy-advisory',
    title: 'Strategy & Advisory',
    body: 'We help organizations chart their course and build the systems needed to achieve lasting impact. Our strategic planning services combine rigorous analysis with participatory approaches to create actionable roadmaps aligned with national, regional, and international development frameworks.',
    scope: 'Strategic planning · Project & programme management · Readiness assessments · Policy advisory',
  },
  {
    href: '/services/research-analytics',
    title: 'Research and Data Analytics',
    body: 'We conduct rigorous research that generates actionable insights for development decision-making. Our research designs balance methodological rigor with practical feasibility, ensuring findings are both credible and useful.',
    scope: 'Applied research · Data analysis & visualization · Knowledge management & information systems',
  },
  {
    href: '/services/mel',
    title: 'Monitoring, Evaluation, and Learning (MEL)',
    body: 'Strong M&E starts with solid frameworks. We design comprehensive monitoring and evaluation systems that link strategic objectives to measurable indicators, ensuring you can track progress and demonstrate results.',
    scope: 'M&E frameworks · Evaluations · Disaster response M&E · Capacity building · Real-time monitoring',
  },
  {
    href: '/services/ict-systems',
    title: 'ICT Consulting, Project Management & Systems Development',
    body: 'RML designs, builds, and manages information systems for organizations that cannot afford downtime, data loss, or a system nobody ends up using — and the systems we build generate the data our M&E and research practices analyze.',
    scope: 'ICT strategy · Systems development · Health information systems · Project management · Systems integration',
  },
];
---

<BaseLayout
  title="Services — Results Matrix Limited"
  description="Four integrated practice areas: Strategy & Advisory, Research and Data Analytics, Monitoring, Evaluation, and Learning (MEL), and ICT & Systems Development — serving governments and development organizations across the Caribbean."
>
  <PageHero
    title="Our Services"
    lede="Four interconnected practice areas — strategy, research, MEL, and ICT & systems — designed to meet the unique challenges of Small Island Developing States while maintaining international best practice standards."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <div class="grid gap-8">
      {
        areas.map((area, i) => (
          <article
            class="group relative flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-xs transition-all duration-200 hover:border-slate-300 hover:shadow-md sm:p-8 lg:flex-row lg:items-center lg:gap-12"
          >
            <div class="lg:w-3/5">
              <span class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-800">
                Practice 0{i + 1}
              </span>
              <h2 class="mt-3 text-2xl font-bold tracking-tight text-brand-950 transition-colors group-hover:text-brand-700 sm:text-3xl">
                <a href={area.href} class="focus:outline-none">
                  {area.title}
                </a>
              </h2>
              <p class="mt-3 max-w-prose font-serif text-base leading-relaxed text-slate-700 sm:text-lg">{area.body}</p>
              
              <div class="mt-5 flex flex-wrap gap-2">
                {area.scope.split(' · ').map((item) => (
                  <span class="rounded bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-6 lg:mt-0 lg:w-2/5 lg:border-t-0 lg:pt-0 lg:text-right">
              <a
                href={area.href}
                class="press inline-flex items-center justify-center gap-2 rounded-lg bg-brand-900 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800"
              >
                <span>Explore practice area</span>
                <span aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-1">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand
    heading="Not sure where to start?"
    text="Tell us what you’re working on — a free discovery session will point you to the right support."
    primaryHref="/contact"
    primaryLabel="Schedule a discovery session"
  />
</BaseLayout>
