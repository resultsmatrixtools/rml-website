<BaseLayout
  title="Strategy & Advisory — Results Matrix Limited"
  description="Strategic planning, project and programme management, readiness assessments, and policy advisory services for Caribbean governments and development organizations."
>
  <PageHero
    title="Strategy & Advisory"
    lede="We help organizations chart their course and build the systems needed to achieve lasting impact. Our strategic planning services combine rigorous analysis with participatory approaches to create actionable roadmaps aligned with national, regional, and international development frameworks."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <div class="space-y-8">
      {blocks.map((block) => <SubService {...block} />)}
    </div>
  </section>

  <CtaBand
    heading="Let’s talk about your strategy"
    text="Schedule a free discovery session to explore how we can support your planning, management, or policy work."
    primaryHref="/contact"
    primaryLabel="Get in touch"
    secondaryHref="/services"
    secondaryLabel="All services"
  />
</BaseLayout>
