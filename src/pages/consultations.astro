---
// Consultations — Paid Advisory Sessions offer & dual payment path layout (BRIEF.md §6).
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketingConsent from '../components/MarketingConsent.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

import { crmEnabled } from '../lib/crm';
import { PAYMENT_PROVIDER } from '../lib/site';

// Card payment needs the CRM endpoint (it starts the checkout) and an explicit
// switch, so production stays on "coming soon" until the payment flow is live.
const onlinePaymentEnabled = crmEnabled && import.meta.env.PUBLIC_ONLINE_PAYMENT === 'true';

const sessionFeatures = [
  '60-minute intensive 1:1 advisory session with a Senior RBM / M&E Consultant',
  'Review of your project results framework, indicators, or Theory of Change',
  'Actionable, written recommendations memo delivered within 48 hours',
  'Follow-up Q&A email support for session deliverables',
];

// Sent to HubSpot as the `session_focus` property. A text property rather than
// a dropdown on purpose: a dropdown is validated against its internal option
// values and rejects the entire submission on a mismatch, so free text removes
// a whole class of silent lead loss. See the README runbook.
const sessionFocusOptions = [
  'M&E framework or results matrix review',
  'Indicator design and validation',
  'Theory of Change review',
  'Evaluation design or terms of reference',
  'Strategic planning',
  'ICT systems or data platform advice',
  'Something else',
];

// The invoice path is the one institutional clients actually use, so it is the
// default selection (BRIEF.md §6).
const inputClasses =
  'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base text-slate-900 placeholder:text-slate-400 shadow-2xs transition-all duration-150 focus:border-accent-600 focus:outline-hidden focus:ring-2 focus:ring-accent-600/20';
const labelClasses = 'block text-sm font-semibold text-brand-950';

// Card payments: the CRM's lead-capture function saves the request and returns
// a DimePay checkout URL; the dimepay-webhook function (in the PRISM repo) marks
// the consultation Paid once DimePay confirms. The scheduling link is never
// rendered on this page (BRIEF.md §6): it is emailed after payment.
---

<BaseLayout
  title="Advisory Sessions & Help Desk — Results Matrix Limited"
  description="Focused, 1:1 help-desk advisory sessions with senior RML consultants for M&E frameworks, project indicators, evaluation designs, and strategic planning."
>
  <PageHero
    title="Focused Advisory Sessions"
    lede="Short, high-impact sessions with a senior consultant — bring a specific M&E question or framework challenge, leave with a clear, decision-ready roadmap."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <!-- Value & Inclusion Grid -->
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-brand-950 sm:text-3xl">
          What’s Included in an Advisory Session
        </h2>
        <p class="mt-3 font-serif text-lg leading-relaxed text-slate-700">
          Designed for project managers, permanent secretaries, and MEL leads who need senior expert guidance on specific deliverables without entering a multi-month consulting engagement.
        </p>

        <ul class="mt-8 space-y-4">
          {sessionFeatures.map((feature) => (
            <li class="flex items-start gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-100 text-accent-700 font-bold text-xs">
                ✓
              </span>
              <span class="text-base leading-relaxed text-slate-800 font-medium">{feature}</span>
            </li>
          ))}
        </ul>

        <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50/70 p-6 sm:p-7">
          <h3 class="text-base font-bold text-brand-900">How Booking Works</h3>
          <ol class="mt-4 grid gap-4 sm:grid-cols-3">
            <li class="flex flex-col">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-700">Step 1</span>
              <span class="mt-1 text-sm font-semibold text-brand-950">Select Payment Path</span>
              <span class="mt-1 text-xs text-slate-600">Pay online or request an invoice for bank transfer.</span>
            </li>
            <li class="flex flex-col">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-700">Step 2</span>
              <span class="mt-1 text-sm font-semibold text-brand-950">Receive Booking Link</span>
              <span class="mt-1 text-xs text-slate-600">Your scheduling link is delivered as soon as payment is confirmed.</span>
            </li>
            <li class="flex flex-col">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-700">Step 3</span>
              <span class="mt-1 text-sm font-semibold text-brand-950">Meet Your Consultant</span>
              <span class="mt-1 text-xs text-slate-600">60-minute live session plus written recommendations memo.</span>
            </li>
          </ol>
          <p class="mt-5 text-xs text-slate-600">
            Payment, rescheduling and refund details are in our
            <a href="/consultation-terms/" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">advisory session terms</a>.
          </p>
        </div>
      </div>

      <!-- Payment Paths Sidebar / Cards -->
      <div class="space-y-6">
        <!-- Path 1: Online Payment -->
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-xs">
          <span class="rounded bg-brand-50 px-2.5 py-1 text-xs font-bold text-brand-800">Path 01</span>
          <h3 class="mt-3 text-lg font-bold text-brand-950">Pay Online</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            Instant online checkout by credit or debit card, on {PAYMENT_PROVIDER}'s secure payment page.
          </p>
          
          <div class="mt-6">
            {onlinePaymentEnabled ? (
              <a
                href="#request-invoice"
                data-pay-method="card"
                class="press block w-full rounded-lg bg-brand-800 px-4 py-3 text-center text-sm font-semibold text-white shadow-xs hover:bg-brand-700"
              >
                Pay &amp; Book Session
              </a>
            ) : (
              <div class="rounded bg-slate-100 p-3 text-center text-xs font-semibold text-slate-500">
                Online payment coming soon
              </div>
            )}
          </div>
        </div>

        <!-- Path 2: Bank Transfer / Invoice -->
        <div class="rounded-xl border-2 border-accent-600/80 bg-white p-6 shadow-xs relative">
          <div class="absolute -top-3 right-4 rounded-full bg-accent-600 px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white">
            Recommended for Ministries
          </div>
          <span class="rounded bg-accent-50 px-2.5 py-1 text-xs font-bold text-accent-700">Path 02</span>
          <h3 class="mt-3 text-lg font-bold text-brand-950">Bank Transfer / Invoice</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-600">
            Ideal for government ministries, regional bodies, and international NGOs requiring standard corporate procurement invoicing.
          </p>
          
          <div class="mt-6">
            <a
              href="#request-invoice"
              data-pay-method="bank_transfer"
              class="press block w-full rounded-lg border-2 border-brand-900 bg-brand-900 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-brand-800"
            >
              Request Invoice &amp; Details
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Both paths land here. The invoice route keeps equal standing with paying
       online because ministries and development partners usually cannot pay
       any other way (BRIEF.md §6). The anchor id is kept for existing links. -->
  <section id="request-invoice" class="border-t border-slate-200 bg-slate-50/60 scroll-mt-24">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-2xl font-bold tracking-tight text-brand-950 sm:text-3xl">
        Book Your Session
      </h2>
      <p class="mt-3 font-serif text-lg leading-relaxed text-slate-700">
        Tell us who you are and what you want the session to cover. Pay online by card, or ask
        for an invoice and banking details, the standard procurement route for ministries,
        regional institutions, and development partners.
      </p>

      <div class="mt-10 rounded-xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
        <!-- Submitted state: replaces the form on success. -->
        <div
          id="consult-success"
          hidden
          tabindex="-1"
          role="status"
          class="rounded-lg border border-accent-200 bg-accent-50/60 p-6 focus:outline-hidden"
        >
          <h3 class="text-base font-bold text-brand-950">Request received — thank you.</h3>
          <p id="consult-success-text" class="mt-2 text-sm leading-relaxed text-slate-700">
            We’ll send your invoice and banking details within one business day; your booking link
            follows once payment is confirmed.
          </p>
        </div>

        <!-- Shown for the moment between a saved request and the checkout opening. -->
        <div
          id="consult-redirect"
          hidden
          tabindex="-1"
          role="status"
          class="rounded-lg border border-accent-200 bg-accent-50/60 p-6 focus:outline-hidden"
        >
          <h3 class="text-base font-bold text-brand-950">Taking you to secure checkout…</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            Your request is saved. If the payment page does not open, <a id="consult-redirect-link" href="#request-invoice" class="font-semibold text-accent-700 underline underline-offset-2">use this link</a>.
          </p>
        </div>

        <form id="consult-form" class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="consult-name" class={labelClasses}>Your name</label>
            <input id="consult-name" name="name" type="text" required autocomplete="name" class={inputClasses} />
          </div>
          <div>
            <label for="consult-email" class={labelClasses}>Your email</label>
            <input
              id="consult-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              spellcheck="false"
              class={inputClasses}
            />
          </div>
          <div>
            <label for="consult-organization" class={labelClasses}>Your organization</label>
            <input
              id="consult-organization"
              name="organization"
              type="text"
              required
              autocomplete="organization"
              placeholder="Name to appear on the invoice"
              class={inputClasses}
            />
          </div>
          <div>
            <label for="consult-phone" class={labelClasses}>Your phone number</label>
            <input id="consult-phone" name="phone" type="tel" required autocomplete="tel" class={inputClasses} />
          </div>
          <div class="sm:col-span-2">
            <label for="consult-focus" class={labelClasses}>Preferred session focus</label>
            <select id="consult-focus" name="session_focus" required class={inputClasses}>
              <option value="">— Please choose an option —</option>
              {sessionFocusOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </div>

          <!-- Banking details are never published on the site: they go out with
               the invoice by email. Card is offered only when online payment is
               switched on; the invoice is always available and the default. -->
          {onlinePaymentEnabled ? (
            <fieldset class="sm:col-span-2">
              <legend class={labelClasses}>How would you like to pay?</legend>
              <div class="mt-2 grid gap-3 sm:grid-cols-2">
                <label for="pay-invoice" class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-300 bg-white p-4 has-checked:border-accent-600 has-checked:ring-2 has-checked:ring-accent-600/20">
                  <input id="pay-invoice" type="radio" name="payment_method" value="bank_transfer" checked class="mt-1 accent-accent-700" />
                  <span>
                    <span class="block text-sm font-semibold text-brand-950">Invoice / bank transfer</span>
                    <span class="mt-0.5 block text-xs text-slate-600">We email an invoice with our bank details.</span>
                  </span>
                </label>
                <label for="pay-card" class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-300 bg-white p-4 has-checked:border-accent-600 has-checked:ring-2 has-checked:ring-accent-600/20">
                  <input id="pay-card" type="radio" name="payment_method" value="card" class="mt-1 accent-accent-700" />
                  <span>
                    <span class="block text-sm font-semibold text-brand-950">Pay online by card</span>
                    <span class="mt-0.5 block text-xs text-slate-600">Secure checkout on {PAYMENT_PROVIDER}.</span>
                  </span>
                </label>
              </div>
            </fieldset>
          ) : (
            <input type="hidden" name="payment_method" value="bank_transfer" />
          )}

          <MarketingConsent id="consult-consent" class="sm:col-span-2" />

          <!-- Honeypot: hidden from humans, tempting to bots. -->
          <div class="hidden" aria-hidden="true">
            <label for="consult-website">Website</label>
            <input id="consult-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="sm:col-span-2 pt-1">
            <p
              id="consult-error"
              hidden
              role="alert"
              class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm leading-relaxed text-red-900"
            >
              We could not send your request just now. Please try again, or email us directly at <a href="mailto:info@resultsmatrix.com" class="font-semibold underline underline-offset-2">info@resultsmatrix.com</a>.
            </p>
            <div id="consult-form-turnstile" class="mb-4"></div>
            <button
              id="consult-submit"
              type="submit"
              class="press rounded-lg bg-brand-800 px-7 py-3 text-sm font-semibold text-white shadow-xs hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Request Invoice &amp; Banking Details
            </button>
            <p id="consult-note" class="mt-3 text-xs text-slate-500">
              Payment by bank transfer or invoice. We handle your details strictly in accordance with our <a href="/privacy/" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">privacy policy</a>.
            </p>
          </div>
        </form>

        <noscript>
          <p class="mt-6 rounded-lg border border-slate-300 bg-slate-50 p-4 text-sm leading-relaxed text-slate-700">
            This form needs JavaScript to send your details securely. With it disabled, please email <a href="mailto:info@resultsmatrix.com" class="font-semibold text-accent-700 underline underline-offset-2">info@resultsmatrix.com</a> and mention the session focus you need.
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Have questions before booking?"
    text="A free 20-minute discovery session can help clarify your requirements before committing to a paid session."
    primaryHref="/contact/"
    primaryLabel="Book a free discovery session"
  />

  <script>
    import { splitName, submitForm } from '../lib/hubspot';
    import { mountTurnstile } from '../lib/turnstile';

    const form = document.getElementById('consult-form') as HTMLFormElement;
    void mountTurnstile(document.getElementById('consult-form-turnstile') as HTMLElement);
    const button = document.getElementById('consult-submit') as HTMLButtonElement;
    const success = document.getElementById('consult-success') as HTMLElement;
    const successText = document.getElementById('consult-success-text') as HTMLElement;
    const redirect = document.getElementById('consult-redirect') as HTMLElement;
    const redirectLink = document.getElementById('consult-redirect-link') as HTMLAnchorElement;
    const error = document.getElementById('consult-error') as HTMLElement;
    const note = document.getElementById('consult-note') as HTMLElement;

    type Method = 'card' | 'bank_transfer';
    const INVOICE_LABEL = button.textContent ?? '';
    const INVOICE_NOTE = note.innerHTML;
    const CARD_LABEL = 'Continue to Secure Payment';
    const CARD_NOTE =
      'You will be taken to our payment provider’s secure page to pay by card. Your card details are entered there and never reach this site. We handle your details strictly in accordance with our <a href="/privacy/" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">privacy policy</a>.';

    function method(): Method {
      return new FormData(form).get('payment_method') === 'card' ? 'card' : 'bank_transfer';
    }

    /** Keeps the button and the small print in step with the chosen payment method. */
    function syncMethod() {
      const card = method() === 'card';
      button.textContent = card ? CARD_LABEL : INVOICE_LABEL;
      note.innerHTML = card ? CARD_NOTE : INVOICE_NOTE;
    }

    form.addEventListener('change', syncMethod);

    // "Pay & Book" and "Request Invoice" both land on this form; pick the matching option.
    document.querySelectorAll<HTMLAnchorElement>('[data-pay-method]').forEach((link) => {
      link.addEventListener('click', () => {
        const radio = form.querySelector<HTMLInputElement>(
          `input[name="payment_method"][value="${link.dataset.payMethod}"]`,
        );
        if (radio) {
          radio.checked = true;
          syncMethod();
        }
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const value = (field: string) => String(data.get(field) ?? '');
      const chosen = method();

      // Honeypot: take the identical success path so a bot learns nothing.
      if (value('website').trim()) {
        reveal();
        return;
      }

      error.hidden = true;
      button.disabled = true;
      const label = button.textContent;
      button.textContent = chosen === 'card' ? 'Preparing checkout…' : 'Sending…';

      const result = await submitForm(
        'consult',
        {
          ...splitName(value('name')),
          email: value('email'),
          company: value('organization'),
          phone: value('phone'),
          session_focus: value('session_focus'),
          payment_method: chosen === 'card' ? 'card' : 'Bank transfer/invoice',
        },
        'Consultations — Book a session',
        { marketingConsent: value('marketing_consent') === 'on' },
      );

      if (result.ok) {
        if (chosen === 'card' && result.paymentUrl) {
          goToCheckout(result.paymentUrl);
          return;
        }
        if (chosen === 'card') {
          // The request is saved, but no checkout could be opened (no online price
          // for this session, or the payment provider is unavailable). Fall back
          // to the invoice route rather than lose the lead.
          successText.textContent =
            'We could not open online checkout just now, so we will email you an invoice with payment details within one business day. Your booking link follows once payment is confirmed.';
        }
        reveal();
        return;
      }

      button.disabled = false;
      button.textContent = label;
      error.hidden = false;
    });

    /** Swaps the form for the confirmation and moves focus onto it. */
    function reveal() {
      form.hidden = true;
      success.hidden = false;
      success.focus();
    }

    /** The request is saved; hand the visitor to the payment provider. */
    function goToCheckout(url: string) {
      redirectLink.href = url;
      form.hidden = true;
      redirect.hidden = false;
      redirect.focus();
      window.location.assign(url);
    }

    // Pressing Back from the payment page restores this page from cache with the
    // "taking you to checkout" panel still showing. Say so truthfully, and keep
    // the link, so the visitor can resume without submitting (and saving) twice.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted && !redirect.hidden) {
        const heading = redirect.querySelector('h3');
        const text = redirect.querySelector('p');
        if (heading) heading.textContent = 'Your request is saved — payment is not complete';
        if (text) {
          const link = document.createElement('a');
          link.href = redirectLink.href;
          link.className = 'font-semibold text-accent-700 underline underline-offset-2';
          link.textContent = 'continue to payment';
          text.replaceChildren('Open the payment page again to finish paying: ', link, '.');
        }
      }
    });
  </script>
</BaseLayout>
