---
// Consultations: the services RML sells, read from the CRM (PRISM) at build time.
// Each service has its own page under /consultations/<slug>/ where the visitor
// requests an invoice (or, once switched on, pays by card) for exactly that
// service. Copy, prices and the on/off switch are managed in the CRM under
// Pricing; nothing about a service is written in this repo.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import OrgTypeSwitch from '../components/OrgTypeSwitch.astro';
import ServicePrice from '../components/ServicePrice.astro';
import { loadServices } from '../lib/services-feed';
import { deliveryLabel, pricesDiffer } from '../lib/services';

const { services, currency } = await loadServices();
const showSwitch = services.some(pricesDiffer);
---

<BaseLayout
  title="Advisory Services — Results Matrix Limited"
  description="Fixed-scope advisory services from senior Results Matrix consultants: report reviews, compliance checks, learning reviews and more. See your price and request an invoice."
>
  <PageHero
    title="Advisory Services"
    lede="Fixed-scope services from senior consultants. Choose your organization type to see your price, open the service you need, and request your invoice."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    {
      services.length === 0 ? (
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight text-brand-950">Our services are being updated</h2>
          <p class="mt-3 font-serif text-lg leading-relaxed text-slate-700">
            The list of advisory services is not available right now. Tell us what you need and a senior consultant
            will reply with the right service and its price.
          </p>
          <a
            href="/contact/"
            class="press mt-6 inline-block rounded bg-brand-800 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700"
          >
            Contact us
          </a>
        </div>
      ) : (
        <>
          {showSwitch && <OrgTypeSwitch class="mb-10" />}

          <ul class="divide-y divide-slate-200 border-y border-slate-200">
            {services.map((service) => (
              <li>
                <a
                  href={`/consultations/${service.slug}/`}
                  class="group grid gap-x-8 gap-y-2 py-6 hover:bg-brand-50/50 sm:grid-cols-[minmax(0,1fr)_auto] sm:px-3"
                >
                  <span class="min-w-0">
                    <span class="block text-lg font-bold text-brand-950 group-hover:text-brand-700">{service.name}</span>
                    {service.summary && (
                      <span class="mt-1 block max-w-3xl font-serif text-base leading-relaxed text-slate-700">{service.summary}</span>
                    )}
                    <span class="mt-2 block text-sm font-medium text-slate-600">{deliveryLabel(service)}</span>
                  </span>
                  <span class="flex items-baseline gap-3 sm:flex-col sm:items-end sm:gap-1 sm:text-right">
                    <ServicePrice service={service} currency={currency} class="text-lg font-bold tabular-nums text-brand-950" />
                    <span class="text-sm font-semibold text-accent-700 underline-offset-2 group-hover:underline">
                      {service.quoted ? 'Request a proposal' : 'View and book'}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-slate-600">
            All prices are in {currency === 'JMD' ? 'Jamaican dollars (JMD)' : 'US dollars (USD)'}.
          </p>
        </>
      )
    }
  </section>

  <section class="border-t border-slate-200 bg-slate-50/60">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      <h2 class="text-2xl font-bold tracking-tight text-brand-950">How it works</h2>
      <ol class="mt-6 grid gap-8 sm:grid-cols-3">
        <li>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-700">Step 1</span>
          <span class="mt-1 block text-base font-semibold text-brand-950">Choose a service</span>
          <span class="mt-1 block text-sm leading-relaxed text-slate-700">Pick your organization type to see your price, then open the service you need.</span>
        </li>
        <li>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-700">Step 2</span>
          <span class="mt-1 block text-base font-semibold text-brand-950">Request your invoice</span>
          <span class="mt-1 block text-sm leading-relaxed text-slate-700">We email your invoice and banking details within one business day.</span>
        </li>
        <li>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-700">Step 3</span>
          <span class="mt-1 block text-base font-semibold text-brand-950">Send your documents</span>
          <span class="mt-1 block text-sm leading-relaxed text-slate-700">We confirm your delivery date once payment terms are met and your documents are complete.</span>
        </li>
      </ol>
      <p class="mt-8 text-sm text-slate-600">
        Payment, rescheduling and refund details are in our
        <a href="/consultation-terms/" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">advisory session terms</a>.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Not sure which service you need?"
    text="A free 20-minute discovery session can help clarify your requirements before you choose."
    primaryHref="/contact/"
    primaryLabel="Book a free discovery session"
  />
</BaseLayout>
