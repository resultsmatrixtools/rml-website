---
// Contact — form fields ported from the source site (BRIEF.md §2), heading
// typo fixed ("Lets" → "Let's"). Fields map 1:1 to HubSpot contact
// properties; the actual Forms API v3 submission (portal ID + form GUID via
// env, hutk context, success/error states) is wired in Phase 6. The
// honeypot field ships now.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const industries = [
  'Healthcare',
  'Government',
  'Shipping and Logistics',
  'Non-governmental Organizations',
  'Education',
];

const inputClasses =
  'mt-1.5 w-full rounded border border-slate-300 bg-white px-3.5 py-2.5 text-base text-slate-900 placeholder:text-slate-500 focus:border-brand-600';
const labelClasses = 'block text-sm font-semibold text-slate-800';
---

<BaseLayout
  title="Contact — Results Matrix Limited"
  description="Schedule a free discovery session or send Results Matrix Limited a message about your strategy, research, or M&E needs."
>
  <PageHero
    title="Let’s Start the Conversation"
    lede="Go ahead and schedule a free discovery session or contact us."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <!-- TODO (Phase 6): POST to HubSpot Forms Submission API v3 using
             PUBLIC_HUBSPOT_PORTAL_ID + PUBLIC_HUBSPOT_FORM_GUID_CONTACT,
             include hutk cookie in context, add success/error states. -->
        <!-- Native validation stays on until Phase 6 adds inline errors:
             browser messages beat silent failure. -->
        <form method="post" action="#" class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClasses}>Your name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class={inputClasses} />
          </div>
          <div>
            <label for="email" class={labelClasses}>Your email</label>
            <input id="email" name="email" type="email" required autocomplete="email" spellcheck="false" class={inputClasses} />
          </div>
          <div>
            <label for="organization" class={labelClasses}>Your organization</label>
            <input id="organization" name="organization" type="text" required autocomplete="organization" class={inputClasses} />
          </div>
          <div>
            <label for="phone" class={labelClasses}>Your phone number</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" class={inputClasses} />
          </div>
          <div>
            <label for="industry" class={labelClasses}>Your industry</label>
            <select id="industry" name="industry" required class={inputClasses}>
              <option value="">— Please choose an option —</option>
              {industries.map((industry) => <option value={industry}>{industry}</option>)}
            </select>
          </div>
          <div>
            <label for="subject" class={labelClasses}>Subject</label>
            <input id="subject" name="subject" type="text" required class={inputClasses} />
          </div>
          <div class="sm:col-span-2">
            <label for="message" class={labelClasses}>Your message (optional)</label>
            <textarea id="message" name="message" rows="6" class={inputClasses}></textarea>
          </div>

          <!-- Honeypot: hidden from humans, tempting to bots. -->
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="sm:col-span-2">
            <button
              type="submit"
              class="press rounded bg-brand-800 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700"
            >
              Contact Us
            </button>
            <p class="mt-3 text-sm text-slate-600">
              We handle your details as described in our <a href="/privacy" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">privacy policy</a>.
            </p>
          </div>
        </form>
      </div>

      <aside>
        <h2 class="text-lg font-bold text-brand-900">Prefer to reach out directly?</h2>
        <ul class="mt-4 space-y-3 text-base">
          <li>
            <a href="mailto:info@resultsmatrix.com" class="font-medium text-accent-700 transition-colors hover:text-accent-800">
              info@resultsmatrix.com
            </a>
          </li>
          <li>
            <a href="tel:+18762986545" class="font-medium text-accent-700 transition-colors hover:text-accent-800">
              876 298 6545
            </a>
          </li>
        </ul>
        <p class="mt-6 max-w-xs text-base text-slate-600">
          Looking for focused M&amp;E help with a fixed scope? Consider a <a href="/consultations" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">paid advisory session</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>
