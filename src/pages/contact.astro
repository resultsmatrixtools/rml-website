---
// Contact — form fields ported from the source site (BRIEF.md §2), heading
// typo fixed ("Lets" → "Let's"). Fields map 1:1 to HubSpot contact
// properties and submit via the Forms API v3 helper in src/lib/hubspot.ts
// (Phase 6). Native constraint validation handles per-field errors; the
// script owns only submit-time success/failure state.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

// Mirrors the HubSpot `industry` dropdown property: the visitor sees `label`,
// the submission carries `value` — HubSpot validates against its internal
// option values and rejects the whole submission on anything it does not know,
// so these must stay in sync with the property (README runbook). Ordered for
// this audience, government first, rather than in HubSpot's own order.
const industries = [
  { label: 'Government', value: 'gov' },
  { label: 'Non-governmental Organizations', value: 'ngo' },
  { label: 'Healthcare', value: 'healthcare' },
  { label: 'Education', value: 'education' },
  { label: 'Environment', value: 'environment' },
  { label: 'Private Sector', value: 'private-sector' },
  { label: 'Consulting', value: 'consult' },
];

const inputClasses =
  'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-base text-slate-900 placeholder:text-slate-400 shadow-2xs transition-all duration-150 focus:border-accent-600 focus:outline-hidden focus:ring-2 focus:ring-accent-600/20';
const labelClasses = 'block text-sm font-semibold text-brand-950';
---

<BaseLayout
  title="Contact — Results Matrix Limited"
  description="Schedule a free discovery session or send Results Matrix Limited a message about your strategy, research, or M&E needs."
>
  <PageHero
    title="Let’s Start the Conversation"
    lede="Schedule a free discovery session with a senior consultant to discuss your strategic objectives, research needs, or M&E systems."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8 lg:col-span-2">
        <h2 class="text-xl font-bold tracking-tight text-brand-950 sm:text-2xl">Book a Discovery Session</h2>
        <p class="mt-1 text-sm text-slate-600">Fill in your details below and a senior consultant will respond within one business day.</p>

        <!-- Submitted state: replaces the form on success (BRIEF.md §5). -->
        <div
          id="contact-success"
          hidden
          tabindex="-1"
          role="status"
          class="mt-8 rounded-lg border border-accent-200 bg-accent-50/60 p-6 focus:outline-hidden"
        >
          <h3 class="text-base font-bold text-brand-950">Request received — thank you.</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">
            A senior consultant will respond within one business day to arrange your discovery
            session. If your enquiry is urgent, call <a href="tel:+18762986545" class="font-semibold text-accent-700 underline underline-offset-2 hover:text-accent-800">876 298 6545</a>.
          </p>
        </div>

        <form id="contact-form" class="mt-8 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class={labelClasses}>Your name</label>
            <input id="name" name="name" type="text" required autocomplete="name" placeholder="e.g. Dr. Sarah Campbell" class={inputClasses} />
          </div>
          <div>
            <label for="email" class={labelClasses}>Your email</label>
            <input id="email" name="email" type="email" required autocomplete="email" spellcheck="false" placeholder="s.campbell@ministry.gov" class={inputClasses} />
          </div>
          <div>
            <label for="organization" class={labelClasses}>Your organization</label>
            <input id="organization" name="organization" type="text" required autocomplete="organization" placeholder="e.g. Ministry of Health & Wellness" class={inputClasses} />
          </div>
          <div>
            <label for="phone" class={labelClasses}>Your phone number</label>
            <input id="phone" name="phone" type="tel" required autocomplete="tel" placeholder="e.g. 876-555-0199" class={inputClasses} />
          </div>
          <div>
            <label for="industry" class={labelClasses}>Your industry</label>
            <select id="industry" name="industry" required class={inputClasses}>
              <option value="">— Please choose an option —</option>
              {industries.map((industry) => <option value={industry.value}>{industry.label}</option>)}
            </select>
          </div>
          <div>
            <label for="subject" class={labelClasses}>Subject</label>
            <input id="subject" name="subject" type="text" required placeholder="e.g. M&E Framework Review" class={inputClasses} />
          </div>
          <div class="sm:col-span-2">
            <label for="message" class={labelClasses}>Your message (optional)</label>
            <textarea id="message" name="message" rows="5" placeholder="Briefly summarize your engagement context or objective..." class={inputClasses}></textarea>
          </div>

          <!-- Honeypot: hidden from humans, tempting to bots. -->
          <div class="hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="sm:col-span-2 pt-2">
            <!-- Submit-time failure only; per-field errors stay with the browser. -->
            <p
              id="contact-error"
              hidden
              role="alert"
              class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm leading-relaxed text-red-900"
            >
              We could not send your message just now. Please try again, or email us directly at <a href="mailto:info@resultsmatrix.com" class="font-semibold underline underline-offset-2">info@resultsmatrix.com</a>.
            </p>
            <button
              id="contact-submit"
              type="submit"
              class="press rounded-lg bg-brand-800 px-7 py-3 text-sm font-semibold text-white shadow-xs hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Request Free Discovery Session
            </button>
            <p class="mt-3 text-xs text-slate-500">
              We handle your details strictly in accordance with our <a href="/privacy" class="font-medium text-accent-700 underline underline-offset-2 hover:text-accent-800">privacy policy</a>.
            </p>
          </div>
        </form>

        <noscript>
          <p class="mt-6 rounded-lg border border-slate-300 bg-slate-50 p-4 text-sm leading-relaxed text-slate-700">
            This form needs JavaScript to send your details securely. With it disabled, please email <a href="mailto:info@resultsmatrix.com" class="font-semibold text-accent-700 underline underline-offset-2">info@resultsmatrix.com</a> or call <a href="tel:+18762986545" class="font-semibold text-accent-700 underline underline-offset-2">876 298 6545</a>.
          </p>
        </noscript>
      </div>

      <aside class="space-y-6">
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-6 sm:p-7">
          <h2 class="text-base font-bold text-brand-950">Direct Contact Details</h2>
          <ul class="mt-4 space-y-3.5 text-sm">
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white text-brand-800 shadow-2xs border border-slate-200">
                ✉
              </span>
              <a href="mailto:info@resultsmatrix.com" class="font-semibold text-accent-700 transition-colors hover:text-accent-800">
                info@resultsmatrix.com
              </a>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white text-brand-800 shadow-2xs border border-slate-200">
                📞
              </span>
              <a href="tel:+18762986545" class="font-semibold text-accent-700 transition-colors hover:text-accent-800">
                876 298 6545
              </a>
            </li>
            <li class="flex items-center gap-3 text-slate-700 font-medium">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white text-brand-800 shadow-2xs border border-slate-200">
                📍
              </span>
              <span>Kingston, Jamaica (Serving Caribbean-wide)</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-accent-200 bg-accent-50/50 p-6">
          <h3 class="text-sm font-bold text-brand-950">Looking for a Fixed-Scope Session?</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-700">
            Have an urgent M&E matrix or project TOC that needs a 1:1 senior review? Check out our <a href="/consultations" class="font-semibold text-accent-700 underline underline-offset-2 hover:text-accent-800">paid advisory sessions</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    import { splitName, submitForm } from '../lib/hubspot';

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const button = document.getElementById('contact-submit') as HTMLButtonElement;
    const success = document.getElementById('contact-success') as HTMLElement;
    const error = document.getElementById('contact-error') as HTMLElement;

    // /consultations links here with ?subject=... for the invoice path.
    const requestedSubject = new URLSearchParams(window.location.search).get('subject');
    if (requestedSubject) {
      (form.elements.namedItem('subject') as HTMLInputElement).value = requestedSubject.slice(0, 200);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const value = (field: string) => String(data.get(field) ?? '');

      // Honeypot: bots fill it, humans never see it. Take the identical
      // success path rather than erroring, so a bot learns nothing.
      if (value('website').trim()) {
        reveal();
        return;
      }

      error.hidden = true;
      button.disabled = true;
      const label = button.textContent;
      button.textContent = 'Sending…';

      const result = await submitForm(
        'contact',
        {
          ...splitName(value('name')),
          email: value('email'),
          company: value('organization'),
          phone: value('phone'),
          industry: value('industry'),
          subject: value('subject'),
          message: value('message'),
        },
        'Contact — Book a Discovery Session',
      );

      if (result.ok) {
        reveal();
        return;
      }

      button.disabled = false;
      button.textContent = label;
      error.hidden = false;
    });

    /** Swaps the form for the confirmation and moves focus onto it. */
    function reveal() {
      form.hidden = true;
      success.hidden = false;
      success.focus();
    }
  </script>
</BaseLayout>
