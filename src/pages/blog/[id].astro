---
// Individual blog post (BRIEF.md §4). Long-form body sets in Source
// Serif 4 via .prose-serif (The Report Rule); hero image is optional
// with schema-enforced alt text. Draft posts build on staging only.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts, formatDate } from '../../lib/blog';
import { blogPostingSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, tags, heroImage, heroImageAlt, draft } =
  post.data;

const path = `/blog/${post.id}/`;
const schema = [
  blogPostingSchema(Astro.site, {
    title,
    description,
    path,
    author,
    pubDate,
    updatedDate,
    tags,
    image: heroImage?.src,
  }),
  breadcrumbSchema(Astro.site, [
    { name: 'Blog', path: '/blog/' },
    { name: title, path },
  ]),
];
---

<BaseLayout
  title={`${title} — Results Matrix Limited`}
  description={description}
  ogType="article"
  ogImage={heroImage?.src}
  ogImageAlt={heroImageAlt}
  ogImageWidth={heroImage?.width}
  ogImageHeight={heroImage?.height}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, author, tags }}
  noindex={draft}
  schema={schema}
>
  <article>
    <header class="bg-brand-900 text-white">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
        {
          draft && (
            <p class="mb-4">
              <span class="rounded bg-amber-100 px-2 py-1 text-sm font-semibold text-amber-900">
                Draft — visible on staging only
              </span>
            </p>
          )
        }
        <h1 class="max-w-3xl text-display">{title}</h1>
        <p class="mt-5 max-w-2xl font-serif text-lg leading-[1.7] text-brand-100">{description}</p>
        <p class="mt-6 text-sm text-brand-200">
          {author} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && (
              <>
                {' '}· Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  <a
                    href={`/blog/tags/${tag}/`}
                    class="rounded border border-brand-500 px-2.5 py-1 text-sm text-brand-100 transition-colors hover:border-brand-300 hover:text-white"
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
      {
        heroImage && (
          <Image
            src={heroImage}
            alt={heroImageAlt ?? ''}
            class="mb-10 w-full max-w-3xl rounded border border-slate-200"
            widths={[640, 960, 1280]}
            sizes="(max-width: 768px) 100vw, 768px"
          />
        )
      }
      <div class="prose-serif">
        <Content />
      </div>

      <footer class="mt-12 border-t border-slate-200 pt-6">
        <a href="/blog/" class="text-sm font-semibold text-accent-700 transition-colors hover:text-accent-800">
          <span aria-hidden="true">←</span> All posts
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>
