---
// Resources — Resource Knowledge Hub with sample templates, guides, and gated download forms (Phase 6 preparation).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const featuredResources = [
  {
    title: 'Results-Based Monitoring & Evaluation Framework Template',
    description: 'A comprehensive 5-stage matrix template designed for Caribbean SIDS ministries and development programs to track indicators, baselines, targets, and data sources.',
    type: 'Toolkit & Template',
    format: 'PDF / XLSX',
    pages: '12 Pages',
    slug: 'rml-me-framework-template',
    badge: 'Popular',
  },
  {
    title: 'Theory of Change Worksheet for Development Interventions',
    description: 'Practical step-by-step logic model worksheet for articulating causal pathways, assumptions, and risk factors in project design.',
    type: 'Worksheet',
    format: 'PDF Document',
    pages: '6 Pages',
    slug: 'rml-theory-of-change-worksheet',
    badge: 'Core Tool',
  },
  {
    title: 'Indicator Development & Validation Checklist',
    description: 'Field-tested checklist for assessing whether custom indicators meet OECD-DAC criteria and regional SIDS data collection realities.',
    type: 'Checklist & Guide',
    format: 'PDF Guide',
    pages: '8 Pages',
    slug: 'rml-indicator-validation-checklist',
    badge: 'Guide',
  },
  {
    title: 'Digital Health Information System Readiness Matrix',
    description: 'Diagnostic toolkit for assessing institutional capacity, data security, and connectivity constraints before deploying health ICT systems.',
    type: 'Diagnostic Matrix',
    format: 'PDF / XLSX',
    pages: '15 Pages',
    slug: 'rml-his-readiness-matrix',
    badge: 'ICT & Systems',
  },
];
---

<BaseLayout
  title="Resources & Toolkits — Results Matrix Limited"
  description="Downloadable M&E frameworks, Theory of Change worksheets, and indicator checklists for development practitioners across the Caribbean."
>
  <PageHero
    title="Resources & Practical Toolkits"
    lede="Practical frameworks, worksheets, and guides from our advisory practice — free to download for Caribbean development practitioners and institutional partners."
  />

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:py-16">
    <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between border-b border-slate-200 pb-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-brand-950">Featured Development Resources</h2>
        <p class="mt-1 text-sm text-slate-600">Select any resource below to access the download preview form.</p>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-full w-fit">
        <span class="h-2 w-2 rounded-full bg-accent-600 animate-pulse"></span>
        <span>Free for institutional use</span>
      </div>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {
        featuredResources.map((resource) => (
          <article class="group relative flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-6 shadow-xs transition-all duration-200 hover:border-slate-300 hover:shadow-md sm:p-7">
            <div>
              <div class="flex items-center justify-between gap-3">
                <span class="rounded bg-accent-50 px-2.5 py-1 text-xs font-bold text-accent-700">
                  {resource.type}
                </span>
                <span class="text-xs font-semibold text-slate-400">
                  {resource.format} · {resource.pages}
                </span>
              </div>
              
              <h3 class="mt-4 text-xl font-bold tracking-tight text-brand-950 transition-colors group-hover:text-brand-700">
                {resource.title}
              </h3>
              
              <p class="mt-3 text-base leading-relaxed text-slate-600">
                {resource.description}
              </p>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-400">Instant Download</span>
              <button
                type="button"
                class="press inline-flex items-center gap-1.5 text-sm font-bold text-accent-700 hover:text-accent-800"
              >
                <span>Request Download</span>
                <span aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-1">→</span>
              </button>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Info note on gated download flow -->
    <div class="mt-12 rounded-xl border border-brand-200/60 bg-brand-50/50 p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-800 text-white">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-brand-950">Tailored Frameworks & Guidance</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-700">
            Need a custom M&E framework or indicator matrix built specifically for your ministry or donor-funded initiative? Our senior consultants design tailored tools aligned with your specific reporting requirements.
          </p>
          <a href="/contact" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-accent-700 hover:text-accent-800">
            <span>Speak with a consultant</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Need something tailored?"
    text="If a template doesn't fit your context, a discovery session will."
    primaryHref="/contact"
    primaryLabel="Get in touch"
  />
</BaseLayout>
